{
  "name": "dogfood-hackathon-platform",
  "version": "1.0.0",
  "description": "Dogfood 2026: Self-Hostable 72-Hour Hackathon Submission & Judging Platform",
  "main": "server/index.js",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node server/index.js",
    "client:install": "npm --prefix client install",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client install && npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "seed": "node -e \"import('./server/db.js').then(m => m.seedDatabase())\"",
    "docker:build": "docker build -t dogfood-hackathon .",
    "docker:run": "docker-compose up -d",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "hackathon",
    "judging",
    "self-hosted",
    "open-source",
    "dogfood2026",
    "glicko",
    "scoring",
    "docker"
  ],
  "author": "Dogfood 2026 Core Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
